rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Container entity
    function isValidContainer(data) {
      return data.containerNumber is string && data.containerNumber.size() > 0 && data.containerNumber.size() <= 30
        && data.size in ['20ft', '40ft', '45ft']
        && data.type is string && data.type.size() <= 40
        && data.status in ['Di Lapangan (CY)', 'Gate-In Terdaftar', 'Loading ke Kapal', 'Discharge / Bongkar', 'Gate-Out Keluar']
        && data.category in ['Impor', 'Ekspor', 'Domestik', 'Transshipment', 'Empty (Kosong)']
        && data.grossWeightKg is number && data.grossWeightKg >= 0
        && data.yardBlock is string && data.yardBlock.size() <= 60
        && data.shippingLine is string && data.shippingLine.size() <= 80;
    }

    // Validation for YardBlock entity
    function isValidYardBlock(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() <= 30
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.zoneType is string && data.zoneType.size() <= 50
        && data.maxTeuCapacity is number && data.maxTeuCapacity > 0
        && data.maxTiers is number && data.maxTiers > 0
        && data.status in ['Operasional Aktif', 'Penuh / Full', 'Maintenance / Perbaikan'];
    }

    // Validation for Vessel entity
    function isValidVessel(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.callsign is string && data.callsign.size() > 0 && data.callsign.size() <= 30
        && data.berthLocation is string && data.berthLocation.size() <= 60
        && data.targetTeus is number && data.targetTeus >= 0
        && data.status in ['Sandar / Berthed', 'Bongkar Muat (Working)', 'Menunggu Pandu', 'Berlayar (Departed)']
        && data.shippingLine is string && data.shippingLine.size() <= 80;
    }

    // Validation for UserProfile entity
    function isValidUserProfile(data) {
      return data.email is string && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['admin', 'superadmin', 'operator'];
    }

    // Containers Collection
    match /containers/{containerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(containerId) && isValidContainer(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(containerId) && isValidContainer(incoming())
        && incoming().createdBy == existing().createdBy;
      allow delete: if isSignedIn() && isValidId(containerId);
    }

    // Yard Blocks Collection
    match /yard_blocks/{blockId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(blockId) && isValidYardBlock(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(blockId) && isValidYardBlock(incoming())
        && incoming().createdBy == existing().createdBy;
      allow delete: if isSignedIn() && isValidId(blockId);
    }

    // Vessels Collection
    match /vessels/{vesselId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(vesselId) && isValidVessel(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(vesselId) && isValidVessel(incoming())
        && incoming().createdBy == existing().createdBy;
      allow delete: if isSignedIn() && isValidId(vesselId);
    }

    // User Profiles Collection
    match /user_profiles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Backward-compatibility matches if any legacy collection queried
    match /ships/{shipId} {
      allow read, write: if isSignedIn();
    }
    match /cargo_manifests/{manifestId} {
      allow read, write: if isSignedIn();
    }
  }
}
