{
  "entities": {
    "Ship": {
      "title": "Ship",
      "description": "Armada kapal penumpang dan muatan milik PT NAZLA",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "maxLength": 50 },
        "captain": { "type": "string", "maxLength": 100 },
        "maxPassengers": { "type": "number" },
        "maxCargoWeightKg": { "type": "number" },
        "maxVolumeM3": { "type": "number" },
        "originPort": { "type": "string", "maxLength": 80 },
        "destPort": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Siap Muat / Sandar", "Sedang Berlayar", "Selesai Bongkar", "Docking / Perawatan"] },
        "departureTime": { "type": "string", "maxLength": 50 },
        "arrivalTime": { "type": "string", "maxLength": 50 },
        "deckLayout": { "type": "string", "maxLength": 200 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "code", "type", "maxPassengers", "maxCargoWeightKg", "originPort", "destPort", "status"]
    },
    "CargoManifest": {
      "title": "CargoManifest",
      "description": "Data manifes muatan barang dan bagasi kapal penumpang",
      "type": "object",
      "properties": {
        "manifestNumber": { "type": "string", "maxLength": 40 },
        "shipId": { "type": "string", "maxLength": 128 },
        "shipName": { "type": "string", "maxLength": 100 },
        "senderOrPassenger": { "type": "string", "maxLength": 100 },
        "identityNumber": { "type": "string", "maxLength": 50 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "itemCount": { "type": "number" },
        "weightKg": { "type": "number" },
        "volumeM3": { "type": "number" },
        "deckPosition": { "type": "string", "maxLength": 100 },
        "handlingNotes": { "type": "string", "maxLength": 300 },
        "shippingFee": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Lunas", "Belum Lunas", "Ditagihkan di Tujuan"] },
        "status": { "type": "string", "enum": ["Terdaftar", "Proses Muat / Stowing", "Di Atas Kapal", "Tiba & Siap Ambil", "Telah Diserahkan"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["manifestNumber", "shipId", "senderOrPassenger", "category", "weightKg", "status", "shippingFee"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil akun pengguna dan admin Nazla Bahari",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "superadmin", "operator"] },
        "company": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "displayName", "role"]
    }
  },
  "firestore": {
    "/ships/{shipId}": {
      "schema": { "$ref": "#/entities/Ship" },
      "description": "Koleksi armada kapal penumpang PT NAZLA"
    },
    "/cargo_manifests/{manifestId}": {
      "schema": { "$ref": "#/entities/CargoManifest" },
      "description": "Koleksi manifes muatan barang dan bagasi kapal penumpang"
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil pengguna dan admin terdaftar"
    }
  }
}
