{
  "entities": {
    "Container": {
      "title": "Container",
      "description": "Petikemas / kontainer operasional terminal pelabuhan PT NAZLA",
      "type": "object",
      "properties": {
        "containerNumber": { "type": "string", "maxLength": 30 },
        "isoCode": { "type": "string", "maxLength": 10 },
        "size": { "type": "string", "enum": ["20ft", "40ft", "45ft"] },
        "type": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Di Lapangan (CY)", "Gate-In Terdaftar", "Loading ke Kapal", "Discharge / Bongkar", "Gate-Out Keluar"] },
        "category": { "type": "string", "enum": ["Impor", "Ekspor", "Domestik", "Transshipment", "Empty (Kosong)"] },
        "grossWeightKg": { "type": "number" },
        "tareWeightKg": { "type": "number" },
        "sealNumber": { "type": "string", "maxLength": 40 },
        "shippingLine": { "type": "string", "maxLength": 80 },
        "consignee": { "type": "string", "maxLength": 100 },
        "yardBlock": { "type": "string", "maxLength": 60 },
        "yardSlot": { "type": "string", "maxLength": 40 },
        "vesselName": { "type": "string", "maxLength": 80 },
        "voyageNumber": { "type": "string", "maxLength": 40 },
        "reeferTemp": { "type": "string", "maxLength": 20 },
        "isHazardous": { "type": "boolean" },
        "dgClass": { "type": "string", "maxLength": 50 },
        "handlingFee": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["containerNumber", "size", "type", "status", "category", "grossWeightKg", "yardBlock", "shippingLine"]
    },
    "YardBlock": {
      "title": "YardBlock",
      "description": "Blok lapangan penumpukan (Container Yard) terminal PT NAZLA",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 80 },
        "zoneType": { "type": "string", "maxLength": 50 },
        "maxTeuCapacity": { "type": "number" },
        "maxTiers": { "type": "number" },
        "equipmentAssigned": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Operasional Aktif", "Penuh / Full", "Maintenance / Perbaikan"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["code", "name", "zoneType", "maxTeuCapacity", "maxTiers", "status"]
    },
    "Vessel": {
      "title": "Vessel",
      "description": "Kapal petikemas yang sandar dan beroperasi di terminal PT NAZLA",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "callsign": { "type": "string", "maxLength": 30 },
        "berthLocation": { "type": "string", "maxLength": 60 },
        "eta": { "type": "string", "maxLength": 50 },
        "etd": { "type": "string", "maxLength": 50 },
        "targetTeus": { "type": "number" },
        "status": { "type": "string", "enum": ["Sandar / Berthed", "Bongkar Muat (Working)", "Menunggu Pandu", "Berlayar (Departed)"] },
        "shippingLine": { "type": "string", "maxLength": 80 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "callsign", "berthLocation", "targetTeus", "status", "shippingLine"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil akun pengguna dan admin Terminal Petikemas Nazla",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "superadmin", "operator"] },
        "company": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "displayName", "role"]
    }
  },
  "firestore": {
    "/containers/{containerId}": {
      "schema": { "$ref": "#/entities/Container" },
      "description": "Koleksi data petikemas terminal PT NAZLA"
    },
    "/yard_blocks/{blockId}": {
      "schema": { "$ref": "#/entities/YardBlock" },
      "description": "Koleksi blok lapangan penumpukan kontainer (CY)"
    },
    "/vessels/{vesselId}": {
      "schema": { "$ref": "#/entities/Vessel" },
      "description": "Koleksi kapal petikemas yang sandar di dermaga terminal"
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil pengguna dan staf operasional terdaftar"
    }
  }
}
